# HTMLのページだけ no-transform を付ける。
# Cloudflareは配信の途中でHTMLに手を入れる機能（アクセス解析の埋め込みなど）を
# 持っているが、no-transform は「中身をいじるな」という標準の指示なので、
# これが効けばダッシュボードの設定に関係なく埋め込みが止まる。
# /* に書くと下のデータ配布の Cache-Control とぶつかるので、ページを並べて書く。
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/install
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/install.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/list
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/list.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/privacy.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  NEL: {"max_age":0}

/download/*
  Cache-Control: public, max-age=300

# 誰でも再利用できるように、データだけは他のサイトからも読めるようにしておく
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900

# 拡張子ごとに型を指定する。nosniff を付けているので、
# ブラウザは書いたとおりに扱う（間違っていても直してくれない）
/data/*.json
  Content-Type: application/json; charset=utf-8

/data/*.csv
  Content-Type: text/csv; charset=utf-8

/data/*.tsv
  Content-Type: text/tab-separated-values; charset=utf-8

