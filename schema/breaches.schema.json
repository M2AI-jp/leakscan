{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leakscan.matsunai.com/schema/breaches.schema.json",
  "title": "LeakScan breach dataset",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "company", "service", "sector", "match", "disclosed", "records", "records_num", "categories", "status", "cause", "ai_link", "sources"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "安定した一意ID。公開後は変更しない（外部から参照されるため）。"
      },
      "company": { "type": "string", "minLength": 1, "description": "公表主体の企業・団体名" },
      "service": { "type": "string", "minLength": 1, "description": "利用者から見たサービス名" },
      "sector": { "type": "string", "minLength": 1, "description": "業種" },
      "match": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domains", "names"],
        "description": "拡張機能がGmailの差出人と照合するためのパターン",
        "properties": {
          "domains": {
            "type": "array",
            "description": "そのサービスがメールを送る際の送信元ドメイン。example.com と *.example.com に一致する。フリーメールや共用ドメインは入れないこと。",
            "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" }
          },
          "names": {
            "type": "array",
            "description": "差出人の表示名に含まれる文字列。日本語を含むものは2文字以上、英字のみのものは4文字以上（短すぎる英字は誤検知の原因）。",
            "items": { "type": "string", "minLength": 2 }
          }
        }
      },
      "disclosed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "公表日 (YYYY-MM-DD)" },
      "records": { "type": "string", "minLength": 1, "description": "公表された件数の表記をそのまま（「最大約100万件」など）" },
      "records_num": { "type": ["integer", "null"], "minimum": 0, "description": "並べ替え用の数値。公表されていなければ null" },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": ["name", "email", "phone", "address", "dob", "gender", "password", "password_hash", "card", "bank", "id_document", "purchase_history", "member_id", "login_credential", "point_balance", "medical", "employment", "identifier", "unknown"]
        }
      },
      "status": { "enum": ["confirmed", "possible", "investigating"] },
      "scope": { "type": "string", "description": "補足（対象範囲、訂正、続報など）。任意。" },
      "cause": { "enum": ["unauthorized_access", "vendor", "saas", "credential", "api", "vulnerability", "malware", "ransomware", "misconfiguration", "unknown"] },
      "ai_link": {
        "enum": ["confirmed", "suspected", "unconfirmed", "supply_chain"],
        "description": "AI関与の確度。推測で confirmed にしないこと。"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "description": "出典。公式発表を最優先。1件以上必須。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
          }
        }
      }
    }
  }
}
