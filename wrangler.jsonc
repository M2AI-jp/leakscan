{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leakscan",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./site"
  },
  "routes": [
    {
      "pattern": "leakscan.matsunai.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
